{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "PixelPulse",
    "version":  "1.0.0",
    "identifier":  "com.renahangil.pixelpulse",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "PixelPulse",
                                    "width":  180,
                                    "height":  36,
                                    "decorations":  false,
                                    "focus":  false,
                                    "skipTaskbar":  true,
                                    "focusable":  true,
                                    "visible":  false,
                                    "transparent":  true,
                                    "maximizable":  false,
                                    "alwaysOnTop":  true,
                                    "shadow":  false,
                                    "resizable":  false,
                                    "minimizable":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}
